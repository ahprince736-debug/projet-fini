# ═══════════════════════════════════════════════════════════════════
# FlashGo API — Variables d'environnement
# ═══════════════════════════════════════════════════════════════════
# 1. Copie ce fichier : cp .env.example .env
# 2. Remplis chaque valeur avec tes vraies clés
# 3. Ne commite JAMAIS le fichier .env (deja dans .gitignore)
# ═══════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://ton-projet.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Serveur ─────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Twilio (SMS) ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# ── Tarification ────────────────────────────────────────────────────
TARIF_BASE_FCFA=500
TARIF_PAR_KM_FCFA=100
QUOTA_GRATUIT_JOUR=3
RETRAIT_MINIMUM_FCFA=500

# ── Domaine (liens de tracking SMS) ──────────────────────────────────
APP_DOMAIN=https://flashgo.bj
